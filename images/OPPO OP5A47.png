                <div class="absolute pc:w-182rpx pc:h-404rpx pc:top-65rpx pc:left-[calc(50%-91rpx)] mo:w-[136.5rpx] mo:h-303rpx mo:left-[176.24rpx] mo:top-[48.75rpx] pad:w-[136.5rpx] pad:h-303rpx pad:left-[176.24rpx] pad:top-[48.75rpx]" ani-autoplay-video="" data-src="/content/dam/oppo/product-asset-library/a/a3x-cn/assets/videos-pink-system_800.flv" loop="false" once="false">
                  <canvas></canvas>
                  <video></video><img data-src-1440="/content/dam/oppo/product-asset-library/a/a3x-cn/assets/videos-pink-system_800_poster-1.jpg.avif" data-src-1024="/content/dam/oppo/product-asset-library/a/a3x-cn/assets/videos-pink-system_800_poster-d7111.jpg.avif" data-src-360="/content/dam/oppo/product-asset-library/a/a3x-cn/assets/videos-pink-system_800_poster-1.jpg.avif" data-src-650="/content/dam/oppo/product-asset-library/a/a3x-cn/assets/videos-pink-system_800_poster-1.jpg.avif" class="">
                </div><img class="image pc:w-498rpx pc:h-498rpx pc:top-[calc(50%-249rpx)] pc:left-[calc(50%-249rpx)] pc:absolute pc:object-cover" data-src-1440="/content/dam/oppo/product-asset-library/a/a3x-cn/assets/images-pack-1301_1201-1.png.avif" data-src-1024="/content/dam/oppo/product-asset-library/a/a3x-cn/assets/images-pack-1301_1201-d7111.png.avif">
