  <div class="pad-only pad:inline-flex pad:flex-col pad:items-start pad:justify-start pad:w-full pad:bg-[#fafafa]">
    <div class="text-wrapper pad:self-stretch pad:px-24px pad:py-80px pad:flex pad:justify-center" data-gtm-view="Part3: 设计">
      <div class="pad:w-720rpx pad:mx-auto pad:flex pad:flex-col pad:items-center pad:justify-center">
        <div class="pad:flex pad:flex-col pad:items-center pad:justify-start pad:self-stretch">
          <p class="mot:text-48px mot:font-medium mot:leading-[1.17] pad:self-stretch pad:text-center pad:text-black pad:text-opacity-95"><span class="text-48px">浪漫色调</span></p>
          <p class="mot:text-48px mot:font-medium mot:leading-[1.17] pad:self-stretch pad:mt-4px pad:text-center pad:text-black pad:text-opacity-95"><span class="text-48px">越级质感</span></p>
        </div>
